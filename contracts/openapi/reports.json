{
  "components" : {
    "schemas" : {
      "GlobalErrorResponse" : {
        "properties" : {
          "code" : {
            "type" : "string"
          },
          "details" : {
            "items" : {
              "type" : "string"
            },
            "type" : "array"
          },
          "message" : {
            "type" : "string"
          },
          "timestamp" : {
            "format" : "date-time",
            "type" : "string"
          }
        },
        "type" : "object"
      },
      "RecordVerificationRequest" : {
        "properties" : {
          "lecturas" : {
            "items" : {
              "$ref" : "#/components/schemas/VerificationReadingRequest"
            },
            "minItems" : 1,
            "type" : "array"
          }
        },
        "required" : [ "lecturas" ],
        "type" : "object"
      },
      "ServiceReportErrorResponse" : {
        "properties" : {
          "code" : {
            "type" : "string"
          },
          "details" : {
            "items" : {
              "type" : "string"
            },
            "type" : "array"
          },
          "message" : {
            "type" : "string"
          },
          "timestamp" : {
            "format" : "date-time",
            "type" : "string"
          }
        },
        "type" : "object"
      },
      "ServiceReportFillRequest" : {
        "properties" : {
          "diagnostico" : {
            "maxLength" : 500,
            "minLength" : 0,
            "type" : "string"
          },
          "fallaReportada" : {
            "description" : "Que reporto el cliente. Nulo deja el valor, blanco lo borra",
            "maxLength" : 500,
            "minLength" : 0,
            "type" : "string"
          },
          "observaciones" : {
            "maxLength" : 500,
            "minLength" : 0,
            "type" : "string"
          },
          "procedimientos" : {
            "description" : "Que se hizo. Obligatorio para poder cerrar el reporte",
            "maxLength" : 500,
            "minLength" : 0,
            "type" : "string"
          },
          "resultado" : {
            "description" : "Como queda el equipo. Obligatorio para poder cerrar el reporte",
            "enum" : [ "OPERATIVO", "OPERATIVO_CON_RESTRICCIONES", "FUERA_DE_SERVICIO" ],
            "type" : "string"
          }
        },
        "type" : "object"
      },
      "ServiceReportOpenRequest" : {
        "properties" : {
          "idEquipoCliente" : {
            "format" : "uuid",
            "type" : "string"
          }
        },
        "required" : [ "idEquipoCliente" ],
        "type" : "object"
      },
      "ServiceReportResponse" : {
        "properties" : {
          "diagnostico" : {
            "type" : "string"
          },
          "estado" : {
            "enum" : [ "BORRADOR", "FINALIZADO" ],
            "type" : "string"
          },
          "estadoActivo" : {
            "type" : "boolean"
          },
          "fallaReportada" : {
            "type" : "string"
          },
          "finalizado" : {
            "description" : "Cuando se cerro el reporte. Nulo mientras es borrador",
            "format" : "date-time",
            "type" : "string"
          },
          "id" : {
            "format" : "uuid",
            "type" : "string"
          },
          "idEquipoCliente" : {
            "format" : "uuid",
            "type" : "string"
          },
          "idOrdenTrabajo" : {
            "format" : "uuid",
            "type" : "string"
          },
          "lecturas" : {
            "items" : {
              "$ref" : "#/components/schemas/VerificationReadingResponse"
            },
            "type" : "array"
          },
          "observaciones" : {
            "type" : "string"
          },
          "procedimientos" : {
            "type" : "string"
          },
          "resultado" : {
            "enum" : [ "OPERATIVO", "OPERATIVO_CON_RESTRICCIONES", "FUERA_DE_SERVICIO" ],
            "type" : "string"
          }
        },
        "type" : "object"
      },
      "VerificationReadingRequest" : {
        "properties" : {
          "idPuntoVerificacion" : {
            "description" : "Punto en el que se tomo. Nulo solo si esa verificacion usa patron y equipo variables",
            "format" : "uuid",
            "type" : "string"
          },
          "idVerificacion" : {
            "description" : "Verificacion activa del tipo del equipo a la que pertenece la lectura",
            "format" : "uuid",
            "type" : "string"
          },
          "secuencia" : {
            "description" : "Cual de las N lecturas de ese punto es",
            "format" : "int32",
            "maximum" : 100,
            "minimum" : 1,
            "type" : "integer"
          },
          "valorEquipo" : {
            "type" : "number"
          },
          "valorPatron" : {
            "type" : "number"
          }
        },
        "required" : [ "idVerificacion", "valorEquipo", "valorPatron" ],
        "type" : "object"
      },
      "VerificationReadingResponse" : {
        "properties" : {
          "id" : {
            "format" : "uuid",
            "type" : "string"
          },
          "idPuntoVerificacion" : {
            "description" : "Nulo si esa verificacion no declara puntos",
            "format" : "uuid",
            "type" : "string"
          },
          "idVerificacion" : {
            "format" : "uuid",
            "type" : "string"
          },
          "secuencia" : {
            "format" : "int32",
            "type" : "integer"
          },
          "unidad" : {
            "type" : "string"
          },
          "valorEquipo" : {
            "type" : "number"
          },
          "valorPatron" : {
            "type" : "number"
          }
        },
        "type" : "object"
      }
    },
    "securitySchemes" : {
      "bearer-jwt" : {
        "bearerFormat" : "JWT",
        "description" : "Alternativa: pegar un token obtenido por otro medio",
        "scheme" : "bearer",
        "type" : "http"
      },
      "keycloak-oauth" : {
        "description" : "Inicia sesion en Keycloak y usa el token en cada peticion",
        "flows" : {
          "authorizationCode" : {
            "authorizationUrl" : "http://localhost:8080/realms/malphasos-realm/protocol/openid-connect/auth",
