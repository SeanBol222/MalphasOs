            "type" : "string",
            "format" : "date-time"
          }
        }
      },
      "CountryCreateRequest" : {
        "type" : "object",
        "properties" : {
          "codigoIso" : {
            "type" : "string",
            "description" : "Codigo ISO 3166-1 alfa-3",
            "example" : "COL",
            "minLength" : 1,
            "pattern" : "^[A-Za-z]{3}$"
          },
          "nombre" : {
            "type" : "string",
            "description" : "Nombre del pais",
            "example" : "Colombia",
            "maxLength" : 50,
            "minLength" : 0
          }
        },
        "required" : [ "codigoIso", "nombre" ]
      },
      "CountryResponse" : {
        "type" : "object",
        "properties" : {
          "id" : {
            "type" : "string",
            "format" : "uuid"
          },
          "codigoIso" : {
            "type" : "string"
          },
          "nombre" : {
            "type" : "string"
          },
          "estadoActivo" : {
            "type" : "boolean"
          }
        }
      },
      "CityCreateRequest" : {
        "type" : "object",
        "properties" : {
          "nombre" : {
            "type" : "string",
            "description" : "Nombre de la ciudad",
            "example" : "Bogota",
            "maxLength" : 50,
            "minLength" : 0
          },
          "idPais" : {
            "type" : "string",
            "format" : "uuid",
            "description" : "Pais al que pertenece"
          }
        },
        "required" : [ "idPais", "nombre" ]
      },
      "CityResponse" : {
        "type" : "object",
        "properties" : {
          "id" : {
            "type" : "string",
            "format" : "uuid"
          },
          "nombre" : {
            "type" : "string"
          },
          "idPais" : {
            "type" : "string",
            "format" : "uuid"
          },
          "estadoActivo" : {
            "type" : "boolean"
          }
        }
      },
      "CountryUpdateRequest" : {
        "type" : "object",
        "properties" : {
          "nombre" : {
            "type" : "string",
            "description" : "Nuevo nombre. Ausente lo deja como esta",
            "example" : "Republica de Colombia",
            "maxLength" : 50,
            "minLength" : 0
          }
        }
      },
      "CityUpdateRequest" : {
        "type" : "object",
        "properties" : {
          "nombre" : {
            "type" : "string",
            "description" : "Nuevo nombre. Ausente lo deja como esta",
            "example" : "Bogota D.C.",
            "maxLength" : 50,
            "minLength" : 0
          },
          "idPais" : {
            "type" : "string",
            "format" : "uuid",
            "description" : "Pais al que se traslada. Ausente la deja donde esta"
          }
        }
      }
    },
    "securitySchemes" : {
      "keycloak-oauth" : {
        "type" : "oauth2",
        "description" : "Inicia sesion en Keycloak y usa el token en cada peticion",
        "flows" : {
          "authorizationCode" : {
            "authorizationUrl" : "http://localhost:8080/realms/malphasos-realm/protocol/openid-connect/auth",
            "tokenUrl" : "http://localhost:8080/realms/malphasos-realm/protocol/openid-connect/token",
            "scopes" : {
              "openid" : "Identificacion del usuario",
              "profile" : "Datos basicos del perfil",
              "email" : "Correo electronico"
            }
          }
        }
      },
      "bearer-jwt" : {
        "type" : "http",
        "description" : "Alternativa: pegar un token obtenido por otro medio",
