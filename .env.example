# Plantilla de variables de entorno para el entorno local de MalphasOS.
#
#   cp .env.example .env
#
# Luego cambia TODAS las contrasenas. El archivo .env real esta en .gitignore
# y nunca debe commitearse.

# ---------------------------------------------------------------------------
# Aplicacion
# ---------------------------------------------------------------------------
# Puerto expuesto en tu maquina (dentro de la red de docker siempre es 8081).
APP_HOST_PORT=8081

# ---------------------------------------------------------------------------
# PostgreSQL
# ---------------------------------------------------------------------------
# Base de datos de la aplicacion. El esquema lo crea Flyway al arrancar el backend.
POSTGRES_DB=malphasos_db
POSTGRES_USER=malphasos
POSTGRES_PASSWORD=cambiame
# Puerto expuesto en tu maquina (dentro de la red de docker siempre es 5432).
POSTGRES_HOST_PORT=5432

# ---------------------------------------------------------------------------
# Keycloak
# ---------------------------------------------------------------------------
# Base de datos propia de Keycloak, dentro de la misma instancia de PostgreSQL.
# La crea docker/postgres/init/01-create-keycloak-db.sql al inicializar el volumen.
KC_DB_NAME=keycloak
# Usuario administrador inicial de la consola de Keycloak.
KC_ADMIN_USER=admin
KC_ADMIN_PASSWORD=cambiame
# Hostname publico de Keycloak. Con 'localhost' no necesitas tocar /etc/hosts.
KC_HOSTNAME=localhost
KC_HOST_PORT=8080
# Realm que se importa desde docker/keycloak/import. El archivo debe llamarse
# <realm>-realm.json: Keycloak rechaza el import si el nombre no sigue ese patron.
KC_REALM=malphasos-realm
# Secreto del client confidencial que usa el backend contra la Admin API. Keycloak lo genera
# al importar el realm; se consulta en la consola, en Clients > malphasos-backend-admin >
# Credentials, y se pega aqui. Sin el, el alta de usuarios falla.
MALPHASOS_BACKEND_ADMIN_SECRET=whvMvlqalDvXBm639ERIJflZi1u0SfW3

# ---------------------------------------------------------------------------
# RabbitMQ
# ---------------------------------------------------------------------------
RABBITMQ_DEFAULT_USER=malphasos
RABBITMQ_DEFAULT_PASS=cambiame
RABBITMQ_HOST_PORT=5672
# Consola de administracion web: http://localhost:15672
RABBITMQ_MGMT_HOST_PORT=15672

# ---------------------------------------------------------------------------
# pgAdmin (solo desarrollo, perfil "tools")
# ---------------------------------------------------------------------------
#   docker compose --profile tools up -d
# El dominio no puede ser .local ni otro TLD reservado: pgAdmin valida la direccion
# al arrancar y entra en bucle de reinicio si la rechaza.
PGADMIN_DEFAULT_EMAIL=admin@malphasos.com
PGADMIN_DEFAULT_PASSWORD=cambiame
PGADMIN_HOST_PORT=5050
