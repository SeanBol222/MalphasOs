# Variables de entorno locales: contienen credenciales, nunca se commitean.
# La plantilla versionada es .env.example
.env
.env.local
.env.*.local

# Dependencias y productos de compilacion del frontend. Van en la raiz y no solo
# en malphasos-frontend/ a proposito: una rama que salga de antes de que ese
# directorio existiera no tiene su .gitignore, y ahi un `git add -A` se traga
# node_modules entero. Paso el 2026-09-13, con 20.368 archivos.
node_modules/
dist/
.angular/

# Productos de compilacion del backend.
target/

# Todo lo que la herramienta de sesion deja en el repositorio, que no es del proyecto y no debe
# publicarse. Hoy solo hay `.claude/settings.local.json`, y estaba ignorado UNICAMENTE por el fichero
# global del usuario (~/.config/git/ignore): en otro clon, o en CI, un `git add -A` se lo habria
# tragado. Un ignore que vive fuera del repositorio no protege al repositorio.
.claude/
