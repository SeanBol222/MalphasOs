{
  "name": "malphasos-frontend",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "contrato": "npm run contrato:client && npm run contrato:location && npm run contrato:person && npm run contrato:equipment && npm run contrato:work-order && npm run contrato:reports",
    "contrato:client": "npx -y openapi-typescript@7.13.0 ../contracts/openapi/client.json -o src/app/core/api/client.contrato.ts",
    "contrato:location": "npx -y openapi-typescript@7.13.0 ../contracts/openapi/location.json -o src/app/core/api/location.contrato.ts",
    "contrato:person": "npx -y openapi-typescript@7.13.0 ../contracts/openapi/person.json -o src/app/core/api/person.contrato.ts",
    "contrato:equipment": "npx -y openapi-typescript@7.13.0 ../contracts/openapi/equipment.json -o src/app/core/api/equipment.contrato.ts",
    "contrato:work-order": "npx -y openapi-typescript@7.13.0 ../contracts/openapi/work-order.json -o src/app/core/api/work-order.contrato.ts",
    "contrato:reports": "npx -y openapi-typescript@7.13.0 ../contracts/openapi/reports.json -o src/app/core/api/reports.contrato.ts"
  },
  "private": true,
  "packageManager": "npm@11.13.0",
  "dependencies": {
    "@angular/common": "^22.1.0",
    "@angular/compiler": "^22.1.0",
    "@angular/core": "^22.1.0",
    "@angular/forms": "^22.1.0",
    "@angular/platform-browser": "^22.1.0",
    "@angular/router": "^22.1.0",
    "@fontsource-variable/archivo": "^5.3.0",
    "@tanstack/angular-query-experimental": "^5.102.8",
    "keycloak-angular": "^22.0.0",
    "keycloak-js": "^26.2.4",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.1.8",
    "@angular/cli": "^22.1.8",
    "@angular/compiler-cli": "^22.1.0",
    "@tailwindcss/postcss": "^4.1.12",
    "@types/node": "^26.5.1",
    "jsdom": "^28.0.0",
    "postcss": "^8.5.3",
    "prettier": "^3.8.1",
    "tailwindcss": "^4.1.12",
    "typescript": "~6.0.2",
    "vitest": "^4.0.8"
  }
}
