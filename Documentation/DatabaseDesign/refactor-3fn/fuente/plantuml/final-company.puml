@startuml final-company
!pragma layout smetana
skinparam backgroundColor #F3F2F2
skinparam defaultFontName Archivo
skinparam shadowing false
skinparam linetype ortho
skinparam roundCorner 0
skinparam class {
  BackgroundColor #FFFFFF
  BorderColor #6B6866
  ArrowColor #6B6866
  HeaderBackgroundColor #FFFFFF
}
skinparam package {
  BackgroundColor #FBFAFA
  BorderColor #9A9795
  FontColor #2B2928
}
skinparam class<<retirada>> {
  BackgroundColor #F6D9D3
  BorderColor #AE1800
  HeaderBackgroundColor #F6D9D3
  FontColor #AE1800
}
skinparam class<<cambia>> {
  BackgroundColor #F6D9D3
  BorderColor #AE1800
  HeaderBackgroundColor #F6D9D3
  FontColor #AE1800
}
skinparam class<<nueva>> {
  BackgroundColor #E3F0E6
  BorderColor #1F6B35
  HeaderBackgroundColor #E3F0E6
}
hide circle
hide methods

skinparam nodesep 70
skinparam ranksep 90
skinparam padding 4
skinparam defaultFontSize 15

title Propuesta final (PROPUESTO) — company — empresa y documentos

package "company — empresa y documentos" {
entity "empresa" as empresa <<cambia>> {
  * k_id_empresa : uuid <<PK>>
  --
  * b_unica : boolean
  * n_nombre : varchar(160)
  k_nit : varchar(30)
  t_direccion : varchar(200)
  t_movil : varchar(30)
  t_correo : varchar(120)
  t_garantia : varchar(2000)
  t_aclaracion : varchar(2000)
  k_codigo_hoja_de_vida : varchar(40)
  k_codigo_informe : varchar(40)
  k_id_ciudad : uuid <<FK>>
  k_huella_logo : varchar(64) <<FK>>
  .. UQ_empresa_unica ..
}
entity "telefono_empresa" as telefono_empresa <<nueva>> {
  * k_id_telefono_empresa : uuid <<PK>>
  --
  * k_id_empresa : uuid <<FK>>
  * n_telefono_empresa : varchar(30)
  * i_orden : integer
  * b_estado_activo : boolean
}
entity "imagen_documento" as imagen_documento {
  * k_huella : varchar(64) <<PK>>
  --
  * b_contenido : bytea
  * t_tipo : varchar(20)
}
}
entity "ciudad" as ciudad <<otro modulo>> {
}
entity "firma_persona" as firma_persona <<otro modulo>> {
}
entity "reporte_servicio" as reporte_servicio <<otro modulo>> {
}
reporte_servicio }o--o| imagen_documento
empresa }o--o| ciudad
empresa }o--o| imagen_documento
telefono_empresa }o--|| empresa
firma_persona }o--|| imagen_documento
skinparam class<<otro modulo>> {
  BackgroundColor #EDEBEA
  BorderColor #9A9795
  FontColor #6B6866
}
@enduml
