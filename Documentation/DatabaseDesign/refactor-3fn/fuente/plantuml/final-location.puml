@startuml final-location
!pragma layout smetana
skinparam backgroundColor #F3F2F2
skinparam defaultFontName Archivo
skinparam shadowing false
skinparam linetype ortho
skinparam roundCorner 0
skinparam class {
  BackgroundColor #FFFFFF
  BorderColor #6B6866
  ArrowColor #6B6866
  HeaderBackgroundColor #FFFFFF
}
skinparam package {
  BackgroundColor #FBFAFA
  BorderColor #9A9795
  FontColor #2B2928
}
skinparam class<<retirada>> {
  BackgroundColor #F6D9D3
  BorderColor #AE1800
  HeaderBackgroundColor #F6D9D3
  FontColor #AE1800
}
skinparam class<<cambia>> {
  BackgroundColor #F6D9D3
  BorderColor #AE1800
  HeaderBackgroundColor #F6D9D3
  FontColor #AE1800
}
skinparam class<<nueva>> {
  BackgroundColor #E3F0E6
  BorderColor #1F6B35
  HeaderBackgroundColor #E3F0E6
}
hide circle
hide methods

skinparam nodesep 70
skinparam ranksep 90
skinparam padding 4
skinparam defaultFontSize 15

title Propuesta final (PROPUESTO) — location — ubicación

package "location — ubicación" {
entity "pais" as pais {
  * k_id_pais : uuid <<PK>>
  --
  * k_codigo_iso : varchar(3)
  * n_nombre_pais : varchar(50)
  * b_estado_activo : boolean
  .. UQ_pais_codigo_iso ..
  .. UQ_pais_nombre ..
}
entity "ciudad" as ciudad {
  * k_id_ciudad : uuid <<PK>>
  --
  * n_nombre_ciudad : varchar(50)
  * k_id_pais : uuid <<FK>>
  * b_estado_activo : boolean
  .. UQ_ciudad_nombre_por_pais ..
}
}
entity "cliente" as cliente <<otro modulo>> {
}
entity "empresa" as empresa <<otro modulo>> {
}
entity "fabricante" as fabricante <<otro modulo>> {
}
entity "sede" as sede <<otro modulo>> {
}
ciudad }o--|| pais
cliente }o--o| pais
sede }o--|| ciudad
fabricante }o--o| pais
empresa }o--o| ciudad
skinparam class<<otro modulo>> {
  BackgroundColor #EDEBEA
  BorderColor #9A9795
  FontColor #6B6866
}
@enduml
