@startuml actual-company
!pragma layout smetana
skinparam backgroundColor #F3F2F2
skinparam defaultFontName Archivo
skinparam shadowing false
skinparam linetype ortho
skinparam roundCorner 0
skinparam class {
  BackgroundColor #FFFFFF
  BorderColor #6B6866
  ArrowColor #6B6866
  HeaderBackgroundColor #FFFFFF
}
skinparam package {
  BackgroundColor #FBFAFA
  BorderColor #9A9795
  FontColor #2B2928
}
skinparam class<<retirada>> {
  BackgroundColor #F6D9D3
  BorderColor #AE1800
  HeaderBackgroundColor #F6D9D3
  FontColor #AE1800
}
skinparam class<<cambia>> {
  BackgroundColor #F6D9D3
  BorderColor #AE1800
  HeaderBackgroundColor #F6D9D3
  FontColor #AE1800
}
skinparam class<<nueva>> {
  BackgroundColor #E3F0E6
  BorderColor #1F6B35
  HeaderBackgroundColor #E3F0E6
}
hide circle
hide methods

skinparam nodesep 70
skinparam ranksep 90
skinparam padding 4
skinparam defaultFontSize 15

title Esquema actual (V41) — company — empresa y documentos

package "company — empresa y documentos" {
entity "empresa" as empresa <<cambia>> {
  * k_id_empresa : uuid <<PK>>
  --
  * b_unica : boolean
  * n_nombre : varchar(160)
  k_nit : varchar(30)
  t_direccion : varchar(200)
  n_ciudad : varchar(80)
  * t_telefonos : ARRAY
  t_movil : varchar(30)
  t_correo : varchar(120)
  t_garantia : varchar(2000)
  t_aclaracion : varchar(2000)
  k_codigo_hoja_de_vida : varchar(40)
  k_codigo_informe : varchar(40)
  b_logo : bytea
  t_logo_tipo : varchar(20)
  .. UQ_empresa_unica ..
}
entity "imagen_documento" as imagen_documento {
  * k_huella : varchar(64) <<PK>>
  --
  * b_contenido : bytea
  * t_tipo : varchar(20)
}
}
entity "reporte_servicio" as reporte_servicio <<otro modulo>> {
}
reporte_servicio }o--o| imagen_documento
skinparam class<<otro modulo>> {
  BackgroundColor #EDEBEA
  BorderColor #9A9795
  FontColor #6B6866
}
@enduml
