@startuml ordenes_trabajo
left to right direction

skinparam backgroundColor #F3F2F2
skinparam actorBorderColor #EC3013
skinparam actorBackgroundColor #EC3013
skinparam usecaseBorderColor #6b6866
skinparam usecaseBackgroundColor #ffffff

actor "Administrador" as Admin

package "Gestión de Órdenes de Trabajo" {
  usecase "Crear orden de trabajo" as UC1
  usecase "Formulario Orden de trabajo" as UC2
}

Admin --> UC1
UC1 ..> UC2 : <<include>>

' note right of UC1
'   Crear nueva orden de trabajo
'   sin requerir solicitud previa
' end note

' note right of UC2
'   Incluir campos: Cliente, Sede,
'   Áreas, Tipo de servicio, Periodicidad
' end note

@enduml
