@startuml malphasos_general
!define DIRECTION top to bottom direction
skinparam backgroundColor #F3F2F2
skinparam actorBorderColor #EC3013
skinparam actorBackgroundColor #EC3013
skinparam usecaseBorderColor #6b6866
skinparam usecaseBackgroundColor #ffffff

actor "Administrador" as Admin
actor "Usuario" as User

rectangle "MalphasOS" {
  usecase "Iniciar sesión" as UC1
  usecase "Gestionar usuarios" as UC2
  usecase "Generar reportes" as UC3
}

Admin --> UC1
Admin --> UC2
Admin --> UC3

User --> UC1
User --> UC3

note right of UC1
  Autenticarse en el sistema
end note

note right of UC2
  Crear, editar, eliminar usuarios
end note

note right of UC3
  Generar y exportar reportes
end note

@enduml
