# Variables de MalphasOS en produccion (2026-10-17). Ver DESPLIEGUE.md.
#
#   cp .env.prod.example .env.prod
#
# .env.prod esta en .gitignore y NUNCA se commitea. Cada contrasena y cada secreto de aqui se genera
# para este servidor -por ejemplo con `openssl rand -base64 32`- y no se reutiliza de desarrollo.

# ---------------------------------------------------------------------------
# El dominio
# ---------------------------------------------------------------------------
# Sin https:// y sin barra: el nombre que el Caddy del servidor sirve con HTTPS, y en el que se publican
# el frontend, el API y Keycloak. Es tambien el que Keycloak escribe en cada token, asi que se decide
# antes de instalar: cambiarlo despues no es solo cambiarlo aqui.
MALPHASOS_DOMAIN=malphasos.ejemplo.com

# La red de Docker del Caddy del servidor, que ya tiene que existir (2026-11-26). Ver DESPLIEGUE.md.
MALPHASOS_PROXY_NETWORK=web

# ---------------------------------------------------------------------------
# PostgreSQL: la base de la aplicacion y la de Keycloak, en la misma instancia
# ---------------------------------------------------------------------------
POSTGRES_DB=malphasos_db
POSTGRES_USER=malphasos
POSTGRES_PASSWORD=
KC_DB_NAME=keycloak_db

# ---------------------------------------------------------------------------
# Keycloak
# ---------------------------------------------------------------------------
# El administrador del realm «master»: solo se usa desde el propio servidor, para crear el primer
# SuperUsuario. La consola de administracion no se publica.
KC_ADMIN_USER=administrador
KC_ADMIN_PASSWORD=
# El secreto con el que el backend da de alta personas en Keycloak. Lo pone el realm al importarse.
MALPHASOS_BACKEND_ADMIN_SECRET=

# ---------------------------------------------------------------------------
# La aprobacion de las ordenes (2026-11-22)
# ---------------------------------------------------------------------------
# Desde que dia una orden ejecutada espera la aprobacion del supervisor, AAAA-MM-DD. Lo ejecutado antes
# -el historial que traiga una carga de datos- no la espera. El dia que este servidor se pone en marcha,
# posterior a la ultima orden de la carga. Vacia, todo el historial saldria «por aprobar».
APP_APPROVAL_SINCE=

# ---------------------------------------------------------------------------
# Respaldo: uno al dia de las dos bases, con pg_dump
# ---------------------------------------------------------------------------
# A que hora, en horas de 0 a 23, y en que zona horaria.
RESPALDO_HORA=2
TZ=America/Bogota
# Cuantos dias se guardan, y donde. Copiarlos fuera del servidor es cosa de quien despliega.
RESPALDO_DIAS=14
RESPALDO_DIR=./respaldos
